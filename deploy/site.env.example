# Copy to deploy/site.env and fill in. This is non-secret config (no passwords)
# and is committed per site. Every deploy script sources it, so there are no
# hardcoded placeholders to edit.

# ---- Per-site identity ----
SITE_NAME=my-site               # directory under /opt and the compose project name
SITE_DOMAIN=example.com         # bare domain (www is added automatically)
CONTAINER_NAME=my-app           # must match container_name in docker-compose.prod.yml
DB_NAME=my_db
DB_USER=my_user
REPO=dnguyen303/my-site         # GitHub owner/name (used for the deploy-key clone)

# ---- Shared infra on this VPS (defaults match a vethaul-infra install) ----
# To deploy on a DIFFERENT VPS, stand up vethaul-infra there and change these
# to match that box. The site scripts reference only these names, so nothing
# else is VPS-specific.
INFRA_DIR=/opt/vethaul-infra
PG_CONTAINER=infra-postgres
CADDY_CONTAINER=infra-caddy
DOCKER_NETWORK=vethaul-net
